{% extends 'admin/layout.html.twig' %}

{% block body_id 'admin_update' %}

{% block main %}
<section
	class="page-shell update-page"
	id="admin-update-panel"
	data-status-url="{{ path('admin_update_status') }}"
	data-channel-url="{{ path('admin_update_channel') }}"
	data-run-url="{{ path('admin_update_run') }}"
	data-update-token="{{ csrf_token('admin_update') }}"
	data-check-failed="{{ 'update.checkFailed'|trans }}"
	data-start-failed="{{ 'update.startFailed'|trans }}"
	data-up-to-date="{{ 'update.upToDate'|trans }}"
	data-none="{{ 'update.none'|trans }}"
	data-available="{{ 'update.available'|trans({'%version%': '__VERSION__'}) }}"
>
	<h1 class="page-shell__title">
		{{ 'title.update'|trans }}
	</h1>

	<div class="update-card">
		<div class="update-channel">
			<span class="update-label" id="update-channel-label">{{ 'update.channel.label'|trans }}</span>
			<div class="btn-group" role="group" aria-labelledby="update-channel-label">
				<button type="button" class="btn btn-outline-primary js-update-channel" data-channel="stable" aria-pressed="false">
					{{ 'update.channel.stable'|trans }}
				</button>
				<button type="button" class="btn btn-outline-primary js-update-channel" data-channel="prerelease" aria-pressed="false">
					{{ 'update.channel.prerelease'|trans }}
				</button>
			</div>
		</div>
		<p class="update-warning js-update-channel-warning" hidden>{{ 'update.prereleaseWarning'|trans }}</p>
	</div>

	<div class="update-card">
		<div class="js-update-checking">
			<span class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></span>
			{{ 'update.checking'|trans }}
		</div>

		<div class="js-update-summary" hidden>
			<div class="update-metrics">
				<div>
					<span class="update-label">{{ 'update.current'|trans }}</span>
					<strong class="js-update-current-version"></strong>
				</div>
				<div>
					<span class="update-label">{{ 'update.latest'|trans }}</span>
					<strong class="js-update-latest-version"></strong>
					<a class="js-update-release-link" target="_blank" rel="noopener noreferrer" hidden></a>
				</div>
			</div>
			<p class="js-update-summary-text"></p>
			<p class="update-warning js-update-discard-warning" hidden>{{ 'update.discardWarning'|trans }}</p>
			<p class="update-warning js-update-target-warning" hidden>{{ 'update.prereleaseWarning'|trans }}</p>
			<p class="update-warning js-update-prod-warning" hidden>{{ 'update.prodOnly'|trans }}</p>
		</div>

		<div class="alert alert-danger mb-0 js-update-error" hidden></div>

		<div class="update-actions">
			<button type="button" class="btn btn-outline-primary js-update-check">
				<i class="mdi mdi-refresh" aria-hidden="true"></i>
				{{ 'update.checkAgain'|trans }}
			</button>
			<button type="button" class="btn btn-success js-update-start" disabled>
				<i class="mdi mdi-update" aria-hidden="true"></i>
				{{ 'update.start'|trans }}
			</button>
		</div>
	</div>

	<div class="update-card js-update-notes-card" hidden>
		<h2 class="h6">{{ 'update.notes'|trans }}</h2>
		<div class="update-notes js-update-notes"></div>
	</div>

	<div class="update-card js-update-progress-card" hidden>
		<div class="update-progress-header">
			<span>{{ 'update.progress'|trans }}</span>
			<strong class="js-update-progress-value">0%</strong>
		</div>
		<div class="progress">
			<div class="progress-bar progress-bar-striped progress-bar-animated js-update-progress-bar" role="progressbar" style="width: 0%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">0%</div>
		</div>
		<p class="js-update-progress-label"></p>
		<p class="js-update-running-notice">{{ 'update.running'|trans }}</p>
		<ol class="update-steps">
			<li data-step="requirements" data-state="pending">{{ 'update.step.requirements'|trans }}</li>
			<li data-step="fetch" data-state="pending">{{ 'update.step.fetch'|trans }}</li>
			<li data-step="checkout" data-state="pending">{{ 'update.step.checkout'|trans }}</li>
			<li data-step="composer" data-state="pending">{{ 'update.step.composer'|trans }}</li>
			<li data-step="frontend" data-state="pending">{{ 'update.step.frontend'|trans }}</li>
			<li data-step="migrate" data-state="pending">{{ 'update.step.migrate'|trans }}</li>
			<li data-step="cache" data-state="pending">{{ 'update.step.cache'|trans }}</li>
		</ol>
		<h2 class="h6">{{ 'update.log'|trans }}</h2>
		<pre class="update-log js-update-log"></pre>
		<div class="update-actions">
			<button type="button" class="btn btn-primary js-update-reload" hidden>{{ 'update.reload'|trans }}</button>
			<button type="button" class="btn btn-outline-primary js-update-retry" hidden>{{ 'update.retry'|trans }}</button>
		</div>
	</div>
</section>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('js/admin/update') }}
{% endblock %}
