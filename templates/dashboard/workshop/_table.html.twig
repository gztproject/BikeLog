<div class="table-responsive-sm inventory-panel__table-shell">
	<table class="table table-hover table-bordered workshop-table">
		<thead class="thead-dark">
			<tr>
				<th scope="col">{{ 'label.name'|trans }}</th>
				<th scope="col">{{ 'label.workshop.owner'|trans }}</th>

				{% if area == "admin" %}
				<th scope="col">{{ 'label.workshop.clients'|trans }}</th>
				{% endif %}
			</tr>
		</thead>
		<tbody>
			{% for workshop in workshops %}
			<tr>
				<th scope="row">
					<a href="{{ path('workshop_show', { 'id': workshop.id, 'area': area }) }}">{{ workshop.name }}</a>
				</th>
				<td>{{ workshop.owner.username }}</td>

				{% if area == "admin" %}
				<td>
					{% if workshop.clients is not empty %}
						<ul class="workshop-table__stack mb-0 pl-3">
							{% for user in workshop.clients %}
							<li>{{ user.username }}</li>
							{% endfor %}
						</ul>
					{% else %}
						<span class="text-muted">{{ 'label.noneFound.clients'|trans }}</span>
					{% endif %}
				</td>
				{% endif %}
			</tr>
			{% else %}
			<tr class="table-warning">
				<td colspan="{{ area == 'admin' ? 3 : 2 }}" class="text-center">{{ 'label.noneFound.workshops'|trans }}</td>
			</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
